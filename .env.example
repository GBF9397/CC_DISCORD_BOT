# Copy to .env and fill in. Never commit .env or paste the token into a chat.
DISCORD_TOKEN=

# LM Studio server (lms server start)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=gemma4-12b-bionic-v2

# Optional: channels where the bot answers every message, comma-separated, on ONE line
# (right-click channel > Copy Channel ID). A second BOT_CHANNEL_ID= line replaces the first.
BOT_CHANNEL_ID=
# Optional: comma-separated user IDs allowed to use the bot; empty = every member
ALLOWED_USER_IDS=
# Optional: on = looser replies (swearing, dark humor, mature topics, fewer refusals).
# Off when empty. Only for private servers. Hard limits stay in place either way.
UNFILTERED_MODE=
# Optional: on = the bot sometimes sends one of the server's stickers. Off when empty.
STICKERS=
