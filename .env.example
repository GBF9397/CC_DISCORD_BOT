# Copy to .env and fill in. Never commit .env or paste the token into a chat.
DISCORD_TOKEN=

# LM Studio server (lms server start)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=gemma4-12b-bionic-v2

# Optional: channels where the bot answers every message, comma-separated, on ONE line
# (right-click channel > Copy Channel ID). A second BOT_CHANNEL_ID= line replaces the first.
BOT_CHANNEL_ID=
# Optional: comma-separated user IDs allowed to use the bot; empty = every member
ALLOWED_USER_IDS=
# Optional: on = looser replies (swearing, dark humor, mature topics, fewer refusals).
# Off when empty. Only for private servers. Hard limits stay in place either way.
UNFILTERED_MODE=
# Optional: on = the bot sometimes sends one of the server's stickers. Off when empty.
STICKERS=
# Optional: off = no PC monitor window (graphics card, CPU, RAM) when the bot starts. On when empty.
MONITOR_WINDOW=
# Optional: on = members can draw pictures with /draw or !draw. Off when empty.
# Needs ComfyUI running on this PC. While drawing, Gemma is unloaded and the bot answers nobody.
IMAGE_GEN=
COMFYUI_URL=http://127.0.0.1:8188
# Optional: the ComfyUI_windows_portable folder. When set, the bot starts ComfyUI in the
# background (no window) if it isn't running when someone asks for a picture.
COMFYUI_DIR=
# File names of models in ComfyUI's models/checkpoints folder.
# SD_CHECKPOINT is the "anime" style and the default; SD_CHECKPOINT_REALISTIC (optional) adds "realistic".
SD_CHECKPOINT=
SD_CHECKPOINT_REALISTIC=
# Picture width and height: 1024 for SDXL models, 512 for SD 1.5 models
IMAGE_SIZE=1024
# Context length Gemma is reloaded with after drawing (keep 16384+ for the 30-message memory)
LMSTUDIO_CONTEXT=16384
